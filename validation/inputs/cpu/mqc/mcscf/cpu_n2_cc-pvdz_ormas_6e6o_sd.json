{
    "schema": {
        "name": "mqc-frag",
        "version": "1.0"
    },
    "molecules": [
        {
            "xyz": "../../../sample_inputs/n2.xyz",
            "molecular_charge": 0,
            "molecular_multiplicity": 1
        }
    ],
    "model": {
        "method": "casci",
        "basis": "cc-pvdz"
    },
    "keywords": {
        "scf": {
            "maxiter": 100,
            "tolerance": 1e-08
        },
        "mcscf": {
            "n_active_electrons": 6,
            "n_active_orbitals": 6,
            "optimize_orbitals": false,
            "ormas": {
                "subspaces": [
                    1,
                    4
                ],
                "min_electrons": [
                    4,
                    0
                ],
                "max_electrons": [
                    6,
                    2
                ]
            }
        }
    },
    "system": {
        "logger": {
            "level": "Verbose"
        }
    },
    "driver": "Energy"
}
