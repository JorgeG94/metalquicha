{
    "schema": {
        "name": "mqc-frag",
        "version": "1.0"
    },
    "molecules": [
        {
            "xyz": "../../../sample_inputs/water_gamess_ci.xyz",
            "molecular_charge": 0,
            "molecular_multiplicity": 1
        }
    ],
    "model": {
        "method": "casci",
        "basis": "3-21g"
    },
    "keywords": {
        "scf": {
            "maxiter": 200,
            "tolerance": 1e-12
        },
        "mcscf": {
            "n_active_electrons": 8,
            "n_active_orbitals": 12,
            "n_inactive_orbitals": 1,
            "optimize_orbitals": false,
            "ormas": {
                "subspaces": [
                    1,
                    5
                ],
                "min_electrons": [
                    6,
                    0
                ],
                "max_electrons": [
                    8,
                    2
                ]
            }
        }
    },
    "system": {
        "logger": {
            "level": "Verbose"
        }
    },
    "driver": "Energy"
}
