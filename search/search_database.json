agment type( calculation_result_t ), intent(out) :: result private  subroutine xtb_calc_gradient (this, fragment, result) Calculate energy gradient using Extended Tight-Binding (xTB) method Arguments Type Intent Optional Attributes Name class( xtb_method_t ), intent(in) :: this type( physical_fragment_t ), intent(in) :: fragment type( calculation_result_t ), intent(out) :: result private  subroutine xtb_calc_hessian (this, fragment, result) Calculate Hessian using finite differences of gradients Read more… Arguments Type Intent Optional Attributes Name class( xtb_method_t ), intent(in) :: this type( physical_fragment_t ), intent(in) :: fragment type( calculation_result_t ), intent(out) :: result","tags":"","url":"module/mqc_method_xtb.html"},{"title":"mqc_dft_prune – metalquicha","text":"Angular pruning: fewer Lebedev points where the density does not need them An unpruned grid uses the same Lebedev order at every radius, which is\nwasteful at both ends. Very close to a nucleus the density is nearly\nspherical, so a high-order sphere resolves nothing; very far out it is\nalmost gone. Pruning drops the order in those regions and keeps it in the\nvalence shell where the structure is. The NWChem scheme divides each atom’s radial range into five zones by\nr/R_bragg, with thresholds depending on whether the element is H/He,\nsecond row, or heavier, and assigns orders 50, 86, one below the target, the target, one below the target reading outwards. It is what PySCF uses by default, so a pruned grid here\ncan be compared against a pruned grid there point for point. Pruning changes the answer – it is an approximation, not a\nreorganisation. What it must not change is the answer beyond the accuracy\nthe grid claims, which is what the validation checks. Uses mqc_error pic_types mqc_dft_radial module~~mqc_dft_prune~~UsesGraph module~mqc_dft_prune mqc_dft_prune module~mqc_dft_radial mqc_dft_radial module~mqc_dft_prune->module~mqc_dft_radial module~mqc_error mqc_error module~mqc_dft_prune->module~mqc_error pic_types pic_types module~mqc_dft_prune->pic_types module~mqc_dft_radial->module~mqc_error module~mqc_dft_radial->pic_types module~mqc_dft_radial_data mqc_dft_radial_data module~mqc_dft_radial->module~mqc_dft_radial_data module~mqc_dft_radial_data->pic_types Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Used by module~~mqc_dft_prune~~UsedByGraph module~mqc_dft_prune mqc_dft_prune module~mqc_dft_grid mqc_dft_grid module~mqc_dft_grid->module~mqc_dft_prune Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, public, parameter :: PRUNE_NONE = 0 Same order at every radius integer, public, parameter :: PRUNE_NWCHEM = 1 NWChem five-zone scheme real(kind=dp), private, parameter :: ALPHAS (N_THRESHOLDS,3) = reshape([0.25_dp, 0.5_dp, 1.0_dp, 4.5_dp, 0.1667_dp, 0.5_dp, 0.9_dp, 3.5_dp, 0.1_dp, 0.4_dp, 0.8_dp, 2.5_dp], [N_THRESHOLDS, 3]) Zone boundaries in r/R_bragg, one row per element class integer, private, parameter :: MIN_PRUNABLE = 50 Below this order there is nothing to gain, so pruning is skipped integer, private, parameter :: N_PRUNE_ORDERS = 29 Lebedev orders the scheme may select, from 38 upwards This is the Lebedev sequence starting at 38 rather than 6: the scheme\nindexes into it, and the three smallest grids are never chosen. integer, private, parameter :: N_THRESHOLDS = 4 integer, private, parameter :: N_ZONES = 5 integer, private, parameter :: PRUNE_ORDERS (N_PRUNE_ORDERS) = [38, 50, 74, 86, 110, 146, 170, 194, 230, 266, 302, 350, 434, 590, 770, 974, 1202, 1454, 1730, 2030, 2354, 2702, 3074, 3470, 3890, 4334, 4802, 5294, 5810] real(kind=dp), private, parameter :: TINY_RADIUS = 1.0e-200_dp Functions public pure function prune_scheme_name (scheme) result(name) Human-readable scheme name Arguments Type Intent Optional Attributes Name integer, intent(in) :: scheme Return Value character(len=:), allocatable private pure function order_index (n_angular) result(idx) Position of an order in the prunable sequence, or 0 if absent Arguments Type Intent Optional Attributes Name integer, intent(in) :: n_angular Return Value integer Subroutines public  subroutine prune_angular_orders (scheme, atomic_number, r, n_angular, orders, error) Lebedev order for each radial shell of one atom Arguments Type Intent Optional Attributes Name integer, intent(in) :: scheme PRUNE_NONE or PRUNE_NWCHEM integer, intent(in) :: atomic_number Z, for the radius and element class real(kind=dp), intent(in) :: r (:) Radial nodes, Bohr integer, intent(in) :: n_angular Target order for the valence zone integer, intent(out) :: orders (:) Order per shell, same size as r type( error_t ), intent(inout) :: error","tags":"","url":"module/mqc_dft_prune.html"},{"title":"mqc_geometry – metalquicha","text":"Defines the geometry data structure for molecular systems Uses pic_types module~~mqc_geometry~~UsesGraph module~mqc_geometry mqc_geometry pic_types pic_types module~mqc_geometry->pic_types Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Funct