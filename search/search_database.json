l :: json_data JSON output data interface public module subroutine do_fragment_work(fragment_idx, result, method_config, phys_frag, calc_type, world_comm, print_geometry) Implementation → Arguments Type Intent Optional Attributes Name integer(kind=int64), intent(in) :: fragment_idx type( calculation_result_t ), intent(out) :: result type( method_config_t ), intent(in) :: method_config Method configuration type( physical_fragment_t ), intent(in), optional :: phys_frag integer(kind=int32), intent(in) :: calc_type type(comm_t), intent(in), optional :: world_comm logical, intent(in), optional :: print_geometry interface public module subroutine global_coordinator(ctx, json_data) Implementation → Arguments Type Intent Optional Attributes Name class(*), intent(inout) :: ctx type( json_output_data_t ), intent(out), optional :: json_data JSON output data interface public module subroutine node_coordinator(ctx) Implementation → Arguments Type Intent Optional Attributes Name class(*), intent(in) :: ctx interface public module subroutine node_worker(ctx) Implementation → Arguments Type Intent Optional Attributes Name class(*), intent(in) :: ctx interface public module subroutine serial_fragment_processor(total_fragments, polymers, max_level, sys_geom, method_config, calc_type, json_data, checkpoint) Implementation → Arguments Type Intent Optional Attributes Name integer(kind=int64), intent(in) :: total_fragments integer, intent(in) :: polymers (:,:) integer, intent(in) :: max_level type( system_geometry_t ), intent(in) :: sys_geom type( method_config_t ), intent(in) :: method_config Method configuration integer(kind=int32), intent(in) :: calc_type type( json_output_data_t ), intent(out), optional :: json_data JSON output data type( checkpoint_t ), intent(inout), optional :: checkpoint interface public module subroutine unfragmented_calculation(sys_geom, config, result_out, json_data) Implementation → Arguments Type Intent Optional Attributes Name type( system_geometry_t ), intent(in) :: sys_geom type( driver_config_t ), intent(in) :: config Driver configuration (includes method_config, calc_type, etc.) type( calculation_result_t ), intent(out), optional :: result_out type( json_output_data_t ), intent(out), optional :: json_data interface private module subroutine hessian_coordinator(world_comm, sys_geom, config, json_data) Implementation → Arguments Type Intent Optional Attributes Name type(comm_t), intent(in) :: world_comm type( system_geometry_t ), intent(in) :: sys_geom type( driver_config_t ), intent(in) :: config Driver configuration type( json_output_data_t ), intent(out), optional :: json_data JSON output data interface private module subroutine hessian_worker(world_comm, sys_geom, config) Implementation → Arguments Type Intent Optional Attributes Name type(comm_t), intent(in) :: world_comm type( system_geometry_t ), intent(in) :: sys_geom type( driver_config_t ), intent(in) :: config Driver configuration","tags":"","url":"module/mqc_mbe_fragment_distribution_scheme.html"},{"title":"mqc_dft_grid – metalquicha","text":"Molecular integration grid for DFT Assembles the three pieces into one quadrature. Each atom gets a spherical\nproduct grid – a Treutler-Ahlrichs radial mesh times a Lebedev sphere –\nand the Becke partition then decides how much of each point belongs to the\natom that produced it, so the atomic grids together cover space once. The weight of a point is w = 4*pi * r&#94;2 * dr * w_lebedev * w_becke where w_lebedev sums to 1 over the sphere. The 4*pi therefore appears\nexactly once, here; mqc_dft_radial deliberately leaves it out of its\nweights so it cannot be applied twice. Grid size follows a level from 0 to 9, with radial and angular counts\nchosen per element period. These are the same tables PySCF uses, which is\nwhat makes a level-for-level comparison meaningful. Level 3 is the usual\ndefault and is the one a production calculation should start from. Uses mqc_error pic_types mqc_dft_prune mqc_lebedev mqc_dft_partition mqc_dft_radial module~~mqc_dft_grid~~UsesGraph module~mqc_dft_grid mqc_dft_grid module~mqc_dft_partition mqc_dft_partition module~mqc_dft_grid->module~mqc_dft_partition module~mqc_dft_prune mqc_dft_prune module~mqc_dft_grid->module~mqc_dft_prune module~mqc_dft_radial mqc_dft_radial module~mqc_dft_grid->module~mqc_dft_radial module~mqc_error mqc_error module~mqc_dft_grid->module~mqc_error module~mqc_lebedev mqc_lebedev module~mqc_dft_grid->module~mqc_lebedev pic_types pic_types module~mqc_dft_grid->pic_types module~mqc_dft_partition->module~mqc_dft_radial module~mqc_dft_partition->module~mqc_error module~mqc_dft_partition->pic_types module~mqc_dft_prune->module~mqc_dft_radial module~mqc_dft_prune->module~mqc_error module~mqc_dft_prune->pic_types module~mqc_dft_radial->module~mqc_error module~mqc_dft_radial->pic_types module~mqc_dft_radial_data mqc_dft_radial_data module~mqc_dft_radial->module~mqc_dft_radial_data module~mqc_lebedev->module~mqc_error module~mqc_lebedev->pic_types module~mqc_lebedev_data mqc_lebedev_data module~mqc_lebedev->module~mqc_lebedev_data module~mqc_dft_radial_data->pic_types module~mqc_lebedev_data->pic_types Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, public, parameter :: DEFAULT_GRID_LEVEL = 3 integer, public, parameter :: DEFAULT_PRUNE = PRUNE_NWCHEM Pruning is on by default, as it is in every production DFT code. An\nunpruned level-3 water grid is 52850 points against 20240 pruned, for the\nsame accuracy to well past where the functional itself is reliable. integer, public, parameter :: MAX_GRID_LEVEL = 9 integer, public, parameter :: MIN_GRID_LEVEL = 0 integer, private, parameter :: ANG_POINTS (MIN_GRID_LEVEL:MAX_GRID_LEVEL,N_PERIODS) = transpose(reshape([50, 86, 110, 110, 110, 110, 110, 110, 194, 194, 194, 194, 194, 194, 194, 302, 302, 302, 302, 302, 302, 302, 302, 434, 434, 434, 434, 434, 434, 590, 590, 590, 590, 590, 590, 590, 770, 770, 770, 770, 770, 770, 770, 974, 974, 974, 974, 974, 974, 974, 1202, 1202, 1202, 1202, 1202, 1202, 1202, 1202, 1202, 1202, 1202, 1202, 1202, 1454, 1454, 1454, 1454, 1454, 1454, 1454], [N_PERIODS, MAX_GRID_LEVEL+1])) Lebedev points per (level, period) PySCF’s table stores Lebedev degrees and maps them to point counts; these\nare the point counts directly, since that is what lebedev_grid takes. integer, private, parameter :: N_DIM = 3 integer, private, parameter :: N_PERIODS = 7 integer, private, parameter :: PERIOD_LAST_Z (N_PERIODS) = [2, 10, 18, 36, 54, 86, 118] Highest Z in each period, used to place an element in the level tables real(kind=dp), private, parameter :: PI = 3.14159265358979323846_dp integer, private, parameter :: RAD_GRIDS (MIN_GRID_LEVEL:MAX_GRID_LEVEL,N_PERIODS) = transpose(reshape([10, 15, 20, 30, 35, 40, 50, 30, 40, 50, 60, 65, 70, 75, 40, 60, 65, 75, 80, 85, 90, 50, 75, 80, 90, 95, 100, 105, 60, 90, 95, 105, 110, 115, 120, 70, 105, 110, 120, 125, 130, 135, 80, 120, 125, 135, 140, 145, 150, 90, 135, 140, 150, 155, 160, 165, 100, 150, 155, 165, 170, 175, 180, 200, 200, 200, 200, 200, 200, 200], [N_PERIODS, MAX_GRID_LEVEL+1])) Radial shells per (level, period) Derived Types type, public :: dft_grid_t A molecular quadrature: points, weights, and which atom made each point Components Type Visibility Attributes Name Initial integer, public :: adjust = ADJUST_TREUTLER integer, public, allocatable :: atom (:) (n_points), owning atom real(kind=dp), public, allocatable :: coords (:,:) (3, n_points), Bohr integer, public :: n_points = 0 integer, public, allocatable :: numbers (:) (n_atoms), Z, for the partition radii real(kind=dp), public, allocatable :: quad_weights (:) (n_points), the radial times angular weight before the Becke\npartition multiplies it in. Kept because a gradient needs the\npartition weight and the quadrature weight separately – the\npartition depends on where the nuclei are and the quadrature does\nnot, so only one of the two carries a derivative. Recovering it by\ndividing weights by the partition would divide by zero exactly\nwhere the partition underflows. integer, public :: scheme = PARTITION_BECKE real(kind=dp), public, allocatable :: weights (:) (n_points), full volume weight Type-Bound Procedures procedure, public :: destroy => dft_grid_destroy Functions public pure function grid_level_angular (atomic_number, level) result(n_angular) Lebedev points this element gets at this level Arguments Type Intent Optional Attributes Name integer, intent(in) :: atomic_number integer, intent(in) :: level Return Value integer public pure function grid_level_radial (atomic_number, level) result(n_radial) Radial shells this element gets at this level Arguments Type Intent Optional Attributes Name integer, intent(in) :: atomic_number integer, intent(in) :: level Return Value integer private pure function clamp_level (level) result(clamped) Arguments Type Intent Optional Attributes Name integer, intent(in) :: level Return Value integer private pure function element_period (atomic_number) result(period) Period of an element, 1 to 7, for indexing the level tables Arguments Type Intent Optional Attributes Name integer, intent(in) :: atomic_number Return Value integer Subroutines public  subroutine build_dft_grid (atom_coords, atomic_numbers, grid, error, level, scheme, adjust, n_radial, n_angular, prune) Build the molecular grid Read more… Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: atom_coords (:,:) (3, n_atoms), Bohr integer, intent(in) :: atomic_numbers (:) Z per atom type( d