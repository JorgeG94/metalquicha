character(len=:), allocatable private  function optimized_xyz_path () result(path) Where the optimized geometry goes: beside the output document Arguments None Return Value character(len=:), allocatable private  function step_label () result(text) How to name the evaluation that just failed Read more… Arguments None Return Value character(len=:), allocatable Subroutines public  subroutine run_geometry_optimization (resources, config, sys_geom, bonds, error) Optimize sys_geom in place. Every rank calls this. Read more… Arguments Type Intent Optional Attributes Name type( resources_t ), intent(in) :: resources type( driver_config_t ), intent(in) :: config type( system_geometry_t ), intent(inout) :: sys_geom type( bond_t ), intent(in), optional :: bonds (:) type( error_t ), intent(inout) :: error private  subroutine begin_context (resources, config, sys_geom, bonds) Put this optimization where the evaluator can reach it Arguments Type Intent Optional Attributes Name type( resources_t ), intent(in) :: resources type( driver_config_t ), intent(in) :: config type( system_geometry_t ), intent(in) :: sys_geom type( bond_t ), intent(in), optional :: bonds (:) private  subroutine build_residues (sys_geom, residues) Group the atoms the way an internal-coordinate scheme needs them Read more… Arguments Type Intent Optional Attributes Name type( system_geometry_t ), intent(in) :: sys_geom integer, intent(out) :: residues (:) private  subroutine end_context () Let go of the system, so the next optimization starts clean Arguments None private  subroutine evaluate_energy_gradient (n_atoms, coords, energy, gradient, status) One energy and gradient, at the geometry the engine asked for Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: n_atoms real(kind=dp), intent(in) :: coords (3,n_atoms) real(kind=dp), intent(out) :: energy real(kind=dp), intent(out) :: gradient (3,n_atoms) integer, intent(out) :: status private  subroutine freeze_term_list (sys_geom, config) Choose the MBE term list once, here, and keep it for the whole run Read more… Arguments Type Intent Optional Attributes Name type( system_geometry_t ), intent(in) :: sys_geom type( driver_config_t ), intent(in) :: config private  subroutine probe_gradient (n_atoms, coords, status) Ask for one gradient, and report only whether it worked Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: n_atoms real(kind=dp), intent(in) :: coords (3,n_atoms) integer, intent(out) :: status private  subroutine receive_geometry (comm, sys_geom) A worker’s half of moving a geometry from rank 0 Arguments Type Intent Optional Attributes Name type(comm_t), intent(in) :: comm type( system_geometry_t ), intent(inout) :: sys_geom private  subroutine record_step (n_atoms, coords, energy) Keep one accepted geometry, growing the trajectory to fit Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: n_atoms real(kind=dp), intent(in) :: coords (3,n_atoms) real(kind=dp), intent(in) :: energy private  subroutine report_result (final_energy, converged, tolerance) Say where it ended up, and whether that is a minimum Read more… Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: final_energy logical, intent(in) :: converged real(kind=dp), intent(in) :: tolerance private  subroutine report_settings (config, n_atoms) Say what is about to be optimized, and how Arguments Type Intent Optional Attributes Name type( driver_config_t ), intent(in) :: config integer, intent(in) :: n_atoms private  subroutine run_step (step_config, result, write_output) One calculation at the current geometry, on the frozen term list Read more… Arguments Type Intent Optional Attributes Name type( driver_config_t ), intent(in) :: step_config type( calculation_result_t ), intent(out) :: result logical, intent(in), optional :: write_output private  subroutine send_final_geometry (comm, sys_geom) Move a geometry to the workers, with the command a