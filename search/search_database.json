 ) ! The last round is an energy rather than a gradient, and both sides ! have to agree on which: the calculation type decides what each ! fragment computes, so a worker still doing gradients while rank 0 ! collects energies produces a result assembled from two different ! calculations. step_config = gradient_config if ( command == OPT_CMD_FINAL ) step_config % calc_type = CALC_TYPE_ENERGY saved_level = logger % log_level if ( saved_level < verbose_level ) call logger % configure ( level = warning_level ) call run_step ( step_config , result ) call logger % configure ( level = saved_level ) end do end subroutine worker_loop","tags":"","url":"proc/worker_loop.html"},{"title":"write_final_single_point – metalquicha","text":"private  subroutine write_final_single_point(sys_geom) Uses mqc_driver proc~~write_final_single_point~~UsesGraph proc~write_final_single_point write_final_single_point module~mqc_driver mqc_driver proc~write_final_single_point->module~mqc_driver module~mqc_calc_types mqc_calc_types module~mqc_driver->module~mqc_calc_types module~mqc_checkpoint mqc_checkpoint module~mqc_driver->module~mqc_checkpoint module~mqc_config_adapter mqc_config_adapter module~mqc_driver->module~mqc_config_adapter module~mqc_config_types mqc_config_types module~mqc_driver->module~mqc_config_types module~mqc_error mqc_error module~mqc_driver->module~mqc_error module~mqc_fingerprint mqc_fingerprint module~mqc_driver->module~mqc_fingerprint module~mqc_frag_utils mqc_frag_utils module~mqc_driver->module~mqc_frag_utils module~mqc_fraglist mqc_fraglist module~mqc_driver->module~mqc_fraglist module~mqc_io_helpers mqc_io_helpers module~mqc_driver->module~mqc_io_helpers module~mqc_json mqc_json module~mqc_driver->module~mqc_json module~mqc_json_output_types mqc_json_output_types module~mqc_driver->module~mqc_json_output_types module~mqc_json_writer mqc_json_writer module~mqc_driver->module~mqc_json_writer module~mqc_many_body_expansion mqc_many_body_expansion module~mqc_driver->module