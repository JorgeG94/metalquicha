_dp , 2.0_dp , 1.7_dp , 1.5_dp , & 1.5_dp , 1.35_dp , 1.35_dp , 1.25_dp , & 1.2_dp , 1.25_dp , 1.3_dp , 1.5_dp , & 1.5_dp , 1.3_dp , 1.2_dp , 1.2_dp , & 1.15_dp , 1.15_dp , 1.15_dp , 2.5_dp , & 2.2_dp , 2.5_dp , 1.5_dp , 1.5_dp , & 1.5_dp , 1.5_dp , 1.5_dp , 1.5_dp , & 1.5_dp , 1.5_dp , 1.5_dp , 1.5_dp , & 1.5_dp , 1.5_dp , 1.5_dp , 1.5_dp , & 1.5_dp , 1.5_dp , 1.5_dp , 1.5_dp , & 1.5_dp , 1.5_dp , 1.5_dp , 1.5_dp , & 1.5_dp , 1.5_dp , 1.5_dp , 1.5_dp , & 1.5_dp , 1.5_dp , 1.5_dp , 2.5_dp , & 2.1_dp , 3.685_dp , 1.5_dp , 1.5_dp , & 1.5_dp , 1.5_dp , 1.5_dp , 1.5_dp , & 1.5_dp , 1.5_dp , 1.5_dp , 1.5_dp , & 1.5_dp , 1.5_dp , 1.5_dp , 1.5_dp ] real ( dp ), parameter :: BRAGG_RADII_TABLE ( 0 : MAX_BRAGG_Z ) = [ & 3.779450359403999_dp , 0.6614041435977716_dp , 2.645616574391086_dp , 2.7401028806193395_dp , & 1.984212430793315_dp , 1.6062672058803025_dp , 1.322808287195543_dp , 1.2283219809672903_dp , & 1.133835674739037_dp , 0.9448630622825309_dp , 2.8345891868475928_dp , 3.4015070242171115_dp , & 2.8345891868475928_dp , 2.3621576557063273_dp , 2.0786987370215684_dp , 1.8897261245650618_dp , & 1.8897261245650618_dp , 1.8897261245650618_dp , 3.4015070242171115_dp , 4.157397474043137_dp , & 3.4015070242171115_dp , 3.0235617993040993_dp , 2.645616574391086_dp , 2.551130268162834_dp , & 2.645616574391086_dp , 2.645616574391086_dp , 2.645616574391086_dp , 2.551130268162834_dp , & 2.551130268162834_dp , 2.551130268162834_dp , 2.551130268162834_dp , 2.4566439619345806_dp , & 2.3621576557063273_dp , 2.1731850432498208_dp , 2.1731850432498208_dp , 2.1731850432498208_dp , & 3.590479636673617_dp , 4.440856392727896_dp , 3.7794522491301237_dp , 3.4015070242171115_dp , & 2.929075493075846_dp , 2.7401028806193395_dp , 2.7401028806193395_dp , 2.551130268162834_dp , & 2.4566439619345806_dp , 2.551130268162834_dp , 2.645616574391086_dp , 3.0235617993040993_dp , & 2.929075493075846_dp , 2.929075493075846_dp , 2.7401028806193395_dp , 2.7401028806193395_dp , & 2.645616574391086_dp , 2.6456