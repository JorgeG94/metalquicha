ound Procedures procedure, public :: byte => hash_byte private  subroutine hash_byte (this, value) Fold one byte in Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this integer(kind=int64), intent(in) :: value procedure, public :: flag => hash_flag private  subroutine hash_flag (this, value) Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this logical, intent(in) :: value procedure, public :: hex => hash_hex private  function hash_hex (this) result(hex) The accumulated hash, as 16 lowercase hex digits Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(in) :: this Return Value character(len=FINGERPRINT_LEN) procedure, public :: int => hash_int private  subroutine hash_int (this, value) Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this integer, intent(in) :: value procedure, public :: int_array => hash_int_array private  subroutine hash_int_array (this, values) Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this integer, intent(in) :: values (:) procedure, public :: real => hash_real private  subroutine hash_real (this, value) Fold a double in by its bits, not its digits Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this real(kind=dp), intent(in) :: value procedure, public :: real_array => hash_real_array private  subroutine hash_real_array (this, values) Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this real(kind=dp), intent(in) :: values (:) procedure, public :: text => hash_text private  subroutine hash_text (this, value) Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this character(len=*), intent(in) :: value Source Code type :: hasher_t !! FNV-1a, accumulated field by field !! !! Order matters and is part of the identity: the same values fed in a !! different order give a different hash, whi