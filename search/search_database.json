und ) cycle call core % info ( child , name = name ) if (. not . allocated ( name )) cycle if ( nmer_level ( name ) <= 0 ) then call error % set ( ERROR_VALIDATION , \"Unknown key \" // & quoted ( \"keywords.fragmentation.cutoffs\" , name ) // & \". Use an n-mer name (dimer, trimer, tetramer, \" // & \"pentamer, hexamer, heptamer, octamer) or a level \" // & \"number of 2 or more\" ) return end if end do end subroutine check_cutoffs","tags":"","url":"proc/check_cutoffs.html"},{"title":"check_grandchild_object – metalquicha","text":"private  subroutine check_grandchild_object(core, root, parent_name, name, keys, error) Validate parent_name.name if both levels are there Arguments Type Intent Optional Attributes Name type(json_core), intent(inout) :: core type(json_value), intent(in), pointer :: root character(len=*), intent(in) :: parent_name character(len=*), intent(in) :: name type( key_set_t ), intent(in) :: keys type( error_t ), intent(inout) :: error Calls proc~~check_grandchild_object~~CallsGraph proc~check_grandchild_object check_grandchild_object get get proc~check_grandchild_object->get proc~check_object check_object proc~check_grandchild_object->proc~check_object proc~check_object->get get_child get_child proc~check_object->get_child info info proc~check_object->info proc~allowed_list allowed_list proc~check_object->proc~allowed_list proc~error_set error_t%error_set proc~check_object->proc~error_set proc~is_allowed is_allowed proc~check_object->proc~is_allowed proc~quoted quoted proc~check_object->proc~quoted Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module pr