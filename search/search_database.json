rajectory without the record that says\nwhether it converged is a path to an unknown place. Arguments Type Intent Optional Attributes Name type( system_geometry_t ), intent(in) :: sys_geom type( driver_config_t ), intent(in) :: config real(kind=dp), intent(in) :: final_energy logical, intent(in) :: converged type( error_t ), intent(inout) :: error Calls proc~~write_optimization_record~~CallsGraph proc~write_optimization_record write_optimization_record proc~algorithm_to_string algorithm_to_string proc~write_optimization_record->proc~algorithm_to_string proc~coordinates_to_string coordinates_to_string proc~write_optimization_record->proc~coordinates_to_string proc~error_has_error error_t%error_has_error proc~write_optimization_record->proc~error_has_error proc~optimization_path optimization_path proc~write_optimization_record->proc~optimization_path proc~write_optimization_json write_optimization_json proc~write_optimization_record->proc~write_optimization_json proc~write_trajectory_xyz write_trajectory_xyz proc~write_optimization_record->proc~write_trajectory_xyz proc~get_output_json_filename get_output_json_filename proc~optimization_path->proc~get_output_json_filename add add proc~write_optimization_json->add create_array create_array proc~write_optimization_json->create_array create_object create_object proc~write_optimization_json->create_object destroy destroy proc~write_optimization_json->destroy failed failed proc~write_optimization_json->failed info info proc~write_optimization_json->info initialize initialize proc~write_optimization_json->initialize proc~element_number_to_symbol element_number_to_symbol proc~write_optimization_json->proc~element_number_to_symbol proc~error_set error_t%error_set proc~write_optimization_json->proc~error_set proc~to_angstrom to_angstrom proc~write_optimization_json->proc~to_angstrom proc~write_trajectory_xyz->info proc~write_trajectory_xyz->proc~element_number_to_symbol proc~write_trajectory_xyz->proc~error_set proc~write_traj