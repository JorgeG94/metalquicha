g about the molecule and how it is cut up Arguments Type Intent Optional Attributes Name type( hasher_t ), intent(inout) :: h type( system_geometry_t ), intent(in) :: sys private  subroutine hash_byte (this, value) Fold one byte in Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this integer(kind=int64), intent(in) :: value private  subroutine hash_flag (this, value) Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this logical, intent(in) :: value private  subroutine hash_int (this, value) Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this integer, intent(in) :: value private  subroutine hash_int_array (this, values) Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this integer, intent(in) :: values (:) private  subroutine hash_real (this, value) Fold a double in by its bits, not its digits Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this real(kind=dp), intent(in) :: value private  subroutine hash_real_array (this, values) Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this real(kind=dp), intent(in) :: values (:) private  subroutine hash_text (this, value) Arguments Type Intent Optional Attributes Name class( hasher_t ), intent(inout) :: this character(len=*), intent(in) :: value","tags":"","url":"module/mqc_fingerprint.html"},{"title":"mqc_json_ecp_reader – metalquicha","text":"Parses the ecp_potentials blocks the Basis Set Exchange ships alongside\norbital basis sets, producing the mqc_ecp types. The BSE layout for one element is \"ecp_electrons\": 28,\n\"ecp_potentials\": [\n  { \"angular_momentum\": [3], \"r_exponents\": [2],\n    \"gaussian_exponents\": [\"3.8431140\"],\n    \"coefficients\": [[\"-12.3169000\"]] },\n  { \"angular_momentum\": [0], ... }\n] The local channel is the one with the highest angular momentum , not\nthe one listed first. For every def2 element those happen to coincide –\nthe order is 3, 0, 1, 2 – but the physics is defined by the angular\nmomentum, so that is what this selects on. A tabulation that listed its\nchannels in ascending order would otherwise silently produce a potential\nwith the local and projected parts exchanged, which is a wrong answer\nrather than an error. Exponents and coefficients are stored as strings to preserve every digit,\nexactly as in the orbital basis files, and are read back with\nlist-directed input. Not every element in a file has an ECP, and not every basis set has an\nECP file at all. Both are ordinary: a missing element yields an entry\nwith has_ecp false rather than an error, so a molecule of light atoms\nand heavy ones needs no special casing.\nParse one element’s ECP from a BSE file\nBuild a per-atom ECP set for a molecule Uses mqc_error pic_types mqc_elements mqc_ecp json_module module~~mqc_json_ecp_reader~~UsesGraph module~mqc_json_ecp_reader mqc_json_ecp_reader json_module json_module module~mqc_json_ecp_reader->json_module module~mqc_ecp mqc_ecp module~mqc_json_ecp_reader->module~mqc_ecp module~mqc_elements mqc_elements module~mqc_json_ecp_reader->module~mqc_elements module~mqc_error mqc_error module~mqc_json_ecp_reader->module~mqc_error pic_types pic_types module~mqc_json_ecp_reader->pic_types module~mqc_ecp->pic_types module~mqc_elements->pic_types pic_ascii pic_ascii module~mqc_elements->pic_ascii Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Functions private pure function integer_to_key (value) result(key) An integer as the string BSE keys its elements by Arguments Type Intent Optional Attributes Name integer, intent(in) :: value Return Value character(len=:), allocatable Subroutines public  subroutine build_molecular_ecp_json (json_path, element_symbols, mol_ecp, error) Build a per-atom ECP set for a list of atoms Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: json_path character(len=*), intent(in) :: element_symbols (:) type( molecular_ecp_type ), intent(out) :: mol_ecp type( error_t ), intent(out) :: error public  subroutine read_json_ecp_element (json_path, element_symbol, atom_ecp, error) Parse the ECP for one element, if the file defines one Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: json_path character(len=*), intent(in) :: element_symbol type( atomic_ecp_type ), intent(out) :: atom_ecp type( error_t ), intent(out) :: error private  subroutine channel_angular_momentum (json, base_path, ipot, ang_mom, found) The single angular momentum one ECP channel carries Arguments Type Intent Optional Attributes Name type(json_file), intent(inout) :: json character(len=*), intent(in) :: base_path integer, intent(in) :: ipot integer, intent(out) :: ang_mom logical, intent(out) :: found private  subroutine copy_atomic_ecp (source, dest) Deep copy of one atom’s ECP Arguments Type Intent Optional Attributes Name type( atomic_ecp_type ), intent(in) :: source type( atomic_ecp_type ), intent(out) :: dest private  subroutine copy_ecp_shell (source, dest) Deep copy of one channel Arguments Type Intent Optional Attributes Name type( ecp_shell_type ), intent(in) :: source type( ecp_shell_type ), intent(out) :: dest private  subroutine read_channel (json, base_path, ipot, ang_mom, shell, json_path, error) Read one channel’s primitives Arguments Type Intent Optional Attributes Name type(json_file), intent(inout) :: json character(len=*), intent(in) :: base_path integer, intent(in) :: ipot integer, intent(in) :: ang_mom type( ecp_shell_type ), intent(inout) :: shell character(len=*), intent(in) :: json_path type( error_t ), intent(out) :: error","tags":"","url":"module/mqc_json_ecp_reader.html"},{"title":"mqc_dft_partition – metalquicha","text":"Becke partition of space into atomic cells A molecular integral is done as a sum of atom-centred quadratures, which\nrequires a partition of unity: a set of weights w_A(r) summing to 1 at\nevery point, each concentrated near its atom. Becke’s construction\n[JCP 88, 2547 (1988)] builds them from the confocal elliptical coordinate\nof each atom pair, mu_AB = (|r - R_A| - |r - R_B|) / R_AB smoothed by a cutoff s(mu) that runs from 1 to 0 as mu goes -1 to 1. The\nunnormalised cell function is the product over partners, P_A(r) = prod_{B /= A} s(nu_AB),   w_A = P_A / sum_C P_C Two cutoffs are offered. Becke’s is three iterations of p(x) = x(3-x&#94;2)/2,\nwhich is smooth everywhere and non-zero everywhere – so every atom\ncontributes at every point, and the cost is unavoidably natoms&#94;2 per\npoint. Stratmann’s [CPL 257, 213 (1996)] is a degree-5 polynomial that\nreaches exactly +-1 at |mu| >= a, so distant pairs contribute exactly 0 or\n1 and can be skipped. That is what makes large systems affordable. nu is mu after an adjustment for the two atoms having different sizes,\nso that the cell boundary sits between them rather than halfway. Becke’s\nappendix gives the shift in terms of the radius ratio chi: u = (chi - 1)/(chi + 1),   a = u/(u&#94;2 - 1),  clamped to |a| <= 1/2 which reduces to a = (1/chi - chi)/4. Treutler’s variant uses the square\nroots of the radii instead. Both are available; the choice changes the\nweights slightly and must match whatever a reference is being compared to. Uses mqc_error pic_types mqc_dft_radial module~~mqc_dft_partition~~UsesGraph module~mqc_dft_partition mqc_dft_partition module~mqc_dft_radial mqc_dft_radial module~mqc_dft_partition->module~mqc_dft_radial module~mqc_error mqc_error module~mqc_dft_partition->module~mqc_error pic_types pic_types module~mqc_dft_partition->pic_types module~mqc_dft_radial->module~mqc_error module~mqc_dft_radial->pic_types module~mqc_dft_radial_data mqc_dft_radial_data module~mqc_dft_radial->module~mqc_dft_radial_data module~mqc_dft_radial_data->pic_types Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Used by module~~mqc_dft_partition~~UsedByGraph module~mqc_dft_partition mqc_dft_partition module~mqc_dft_grid mqc_dft_grid module~mqc_dft_grid->module~mqc_dft_partition Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, public, parameter :: ADJUST_BECKE = 1 Bragg radii integer, public, parameter :: ADJUST_NONE = 0 Atomic size adjustment\nAll atoms the same size integer, public, parameter :: ADJUST_TREUTLER = 2 Square roots of the Bragg radii integer, public, parameter :: PARTITION_BECKE = 1 Cutoff profile\nThree iterations of p(x), smooth everywhere integer, public, parameter :: PARTITION_STRATMANN = 2 Degree-5 with a hard cutoff, screenable real(kind=dp), private, parameter :: MAX_ADJUST = 0.5_dp Becke’s clamp on the size-adjustment shift integer, private, parameter :: N_DIM = 3 real(kind=dp), private, parameter :: STRATMANN_A = 0.64_dp Stratmann’s cutoff parameter, eq. 14 real(kind=dp), private, parameter :: TINY_RADIUS = 1.0e-200_dp Guards the ratio when a radius is zero (a ghost atom) Functions public pure function partition_scheme_name (scheme) result(name) Human-readable scheme name, for logs and error messages Arguments Type Intent Optional Attributes Name integer, intent(in) :: scheme Return Value character(len=:), allocatable private pure function becke_cutoff (nu) result(s) Becke’s smooth cutoff: three iterations of p(x) = x(3 - x&#94;2)/2 Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: nu Return Value real(kind=dp) private pure function becke_cutoff_derivative (nu) result(ds) d/dnu of becke_cutoff Read more… Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: nu Return Value real(kind=dp) private pure function stratmann_cutoff (mu) result(s) Stratmann’s cutoff, exactly 1 or 0 outside |mu| >= a Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: mu Return Value real(kind=dp) private pure function stratmann_cutoff_derivative (mu) result(ds) d/dmu of stratmann_cutoff , zero where the cutoff is flat Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: mu Return Value real(kind=dp) Subroutines public  subroutine becke_partition_derivatives (points, atom_coords, atomic_numbers, owner, scheme, adjust, dweights, error) dP_k/dR_A at fixed grid points, as (3, n_atoms, n_points) Read more… Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: points (:,:) (3, n_points), Bohr real(kind=dp), intent(in) :: atom_coords (:,:) (3, n_atoms), Bohr integer, intent(in) :: atomic_numbers (:) Z per atom, for the radii integer, intent(in) :: owner (:) Atom each point belongs to integer, intent(in) :: scheme integer, intent(in) :: adjust real(kind=dp), intent(out) :: dweights (:,:,:) (3, n_atoms, n_points) type( error_t ), intent(inout) :: error public  subroutine becke_partition_weights (points, atom_coords, atomic_numbers, owner, scheme, adjust, weights, error) Partition weight at each grid point, for the atom that owns it Read more… Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: points (:,:) (3, n_points), Bohr real(kind=dp), intent(in) :: atom_coords (:,:) (3, n_atoms), Bohr integer, intent(in) :: atomic_numbers (:) Z per atom, for the radii integer, intent(in) :: owner (:) Atom each point belongs to integer, intent(in) :: scheme PARTITION_BECKE or PARTITION_STRATMANN integer, intent(in) :: adjust ADJUST_NONE, _BECKE or _TREUTLER real(kind=dp), intent(out) :: weights (:) (n_points) type( error_t ), intent(inout) :: error private pure subroutine size_adjustment (atomic_numbers, adjust, shift) Pairwise shift applied to mu so unequal atoms get unequal cells Arguments Type Intent Optional Attributes Name integer, intent(in) :: atomic_numbers (:) integer, intent(in) :: adjust real(kind=dp), intent(out) :: shift (:,:)","tags":"","url":"module/mqc_dft_partition.html"},{"title":"mqc_capi_export – metalquicha","text":"Exists so libmqc.so has a source file of its own. The C entry points are in a static archive and nothing in the program\nreferences them – they are called from outside it – so a linker asked\nfor the archive in the ordinary way would take none of them. The shared\nlibrary is linked with --whole-archive for that reason, and needs one\nsource of its own to be a target at all. This is that source.","tags":"","url":"module/mqc_capi_export.html"},{"title":"mqc_error – metalquicha","text":"Error codes Used by module~~mqc_error~~UsedByGraph module~mqc_error mqc_error module~mpi_fragment_work_smod mpi_fragment_work_smod module~mpi_fragment_work_smod->module~mqc_error module~mqc_group_batching mqc_group_batching module~mpi_fragment_work_smod->module~mqc_group_batching module~mqc_mbe_fragment_