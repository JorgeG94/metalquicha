ent size, monomer indices, displacement code integer , parameter :: N_TASK_PAYLOAD_MSGS = 5 integer ( int32 ) :: fragment_size , fragment_type , disp_code integer , allocatable :: fragment_indices (:) type ( request_t ) :: req ( N_TASK_PAYLOAD_MSGS ) integer ( int64 ) :: task_idx_int64 call build_task_payload_from_row ( task_row , fragment_type , fragment_size , fragment_indices , disp_code ) task_idx_int64 = int ( task_idx , kind = int64 ) call isend ( comm , task_idx_int64 , dest_rank , tag , req ( 1 )) call isend ( comm , fragment_type , dest_rank , tag , req ( 2 )) call isend ( comm , fragment_size , dest_rank , tag , req ( 3 )) call isend ( comm , fragment_indices , dest_rank , tag , req ( 4 )) call isend ( comm , disp_code , dest_rank , tag , req ( 5 )) call wait ( req ( 1 )) call wait ( req ( 2 )) call wait ( req ( 3 )) call wait ( req ( 4 )) call wait ( req ( 5 )) deallocate ( fragment_indices ) end subroutine send_task_payload_from_row","tags":"","url":"proc/send_task_payload_from_row.html"},{"title":"write_optimization_json – metalquicha","text":"public  subroutine write_optimization_json(path, record, error) Write the optimization record as a JSON document Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: path type( optimization_record_t ), intent(in) :: record type( error_t ), intent(inout) :: error Calls proc~~write_optimization_json~~CallsGraph proc~write_optimization_json write_optimization_json add add proc~write_optimization_json->add create_array create_array proc~write_optimization_json->create_array create_object create_object proc~write_optimization_json->create_object destroy destroy proc~write_optimization_json->destroy failed failed proc~write_optimization_json->failed info info proc~write_optimization_json->info initialize initialize proc~write_optimization_json->initialize proc~element_number_to_symbol element_number_to_symbol proc~write_optimization_json->proc~element_number_to_symbol proc~error_set error_t%err