e~mqc_method_mcscf.f90->sourcefile~mqc_method_base.f90 sourcefile~mqc_method_xtb.f90->sourcefile~mqc_error.f90 sourcefile~mqc_method_xtb.f90->sourcefile~mqc_finite_differences.f90 sourcefile~mqc_method_xtb.f90->sourcefile~mqc_physical_fragment.f90 sourcefile~mqc_method_xtb.f90->sourcefile~mqc_result_types.f90 sourcefile~mqc_method_xtb.f90->sourcefile~mqc_method_base.f90 sourcefile~mqc_optimizer_types.f90->sourcefile~mqc_calculation_defaults.f90 sourcefile~mqc_combinatorics.f90->sourcefile~mqc_physical_fragment.f90 sourcefile~mqc_combinatorics.f90->sourcefile~mqc_program_limits.f90 sourcefile~mqc_cuest_bridge_stub.f90->sourcefile~mqc_error.f90 sourcefile~mqc_cuest_bridge_stub.f90->sourcefile~mqc_physical_fragment.f90 sourcefile~mqc_cuest_bridge_stub.f90->sourcefile~mqc_result_types.f90 sourcefile~mqc_cuest_bridge_stub.f90->sourcefile~mqc_cuest_iface.f90 sourcefile~mqc_cuest_iface.f90->sourcefile~mqc_error.f90 sourcefile~mqc_cuest_iface.f90->sourcefile~mqc_method_config.f90 sourcefile~mqc_cuest_iface.f90->sourcefile~mqc_config_types.f90 sourcefile~mqc_fragment_lookup.f90->sourcefile~mqc_error.f90 sourcefile~mqc_libcint_bridge_stub.f90->sourcefile~mqc_error.f90 sourcefile~mqc_libcint_bridge_stub.f90->sourcefile~mqc_physical_fragment.f90 sourcefile~mqc_libcint_bridge_stub.f90->sourcefile~mqc_program_limits.f90 sourcefile~mqc_libcint_bridge_stub.f90->sourcefile~mqc_result_types.f90 sourcefile~mqc_libcint_bridge_stub.f90->sourcefile~mqc_cuest_iface.f90 sourcefile~mqc_semi_numerical_hessian.f90->sourcefile~mqc_error.f90 sourcefile~mqc_semi_numerical_hessian.f90->sourcefile~mqc_finite_differences.f90 sourcefile~mqc_semi_numerical_hessian.f90->sourcefile~mqc_physical_fragment.f90 sourcefile~mqc_semi_numerical_hessian.f90->sourcefile~mqc_result_types.f90 sourcefile~mqc_semi_numerical_hessian.f90->sourcefile~mqc_method_base.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows