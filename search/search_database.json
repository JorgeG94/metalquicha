nd keys want Arguments Type Intent Optional Attributes Name integer, intent(in) :: value Return Value character(len=:), allocatable private pure function join_path (directory, relative) result(joined) Join a directory and a relative path Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: directory character(len=*), intent(in) :: relative Return Value character(len=:), allocatable private pure function nmer_name (level) result(name) The spelled-out key for an n-mer level, or “” past the named range Arguments Type Intent Optional Attributes Name integer, intent(in) :: level Return Value character(len=:), allocatable Subroutines public  subroutine read_json_config_file (filename, config, error) Read and parse a JSON format input file Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename type( mqc_config_t ), intent(out) :: config type( error_t ), intent(out) :: error public  subroutine read_json_config_text (text, config, error) Parse settings – method, driver, keywords – from a JSON string Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: text type( mqc_config_t ), intent(out) :: config type( error_t ), intent(out) :: error private  subroutine optional_int (json, path, value) Fetch an integer if present, leaving value at its default otherwise Arguments Type Intent Optional Attributes Name type(json_file), intent(inout) :: json character(len=*), intent(in) :: path integer, intent(inout) :: value private  subroutine optional_logical (json, path, value) Fetch a boolean if present, leaving value at its default otherwise Arguments Type Intent Optional Attributes Name type(json_file), intent(inout) :: json character(len=*), intent(in) :: path logical, intent(inout) :: value private  subroutine optional_logical_seen (json, path, value, seen) Fetch a boolean, and say whether the deck named it Read more… Arguments Type Intent Optional Attributes Name type(json_file)