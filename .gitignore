# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo

bin/*
build/*

*.mqc
validation_logs/
output_*.json
output_*_fragments.csv

# Out-of-source build directories
build*/

# profiling / scratch
*.nsys-rep
*.sqlite
fail.txt

# Basis sets are extracted from the Basis Set Exchange bundle at CMake
# configure time (see cmake/modules/ExtractBasisSets.cmake). The bundle is
# tracked; the ~900 JSON files it can yield are not.
basis_sets/*.json

# Python bytecode caches -- regenerated on every run, interpreter-version specific
__pycache__/
*.pyc
