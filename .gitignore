# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo

bin/*
build/*

*.mqc
validation_logs/
output_*.json
output_*_fragments.csv
# Written beside the output document by driver "Optimize": the optimized
# geometry, the path taken to it, and the machine-readable record of both.
output_*_optimized.xyz
output_*_trajectory.xyz
output_*_optimization.json

# Out-of-source build directories
build*/

# CMake build trees under any name.
#
# The rules above match on the directory being called build-something. That is
# most of them and not all of them: a scratch tree called `tip` or `v1` is
# invisible to a name-based rule, and `git add -A` in a repository containing
# one stages tens of thousands of files from _deps/ -- including whole cloned
# dependencies, which git records as embedded repositories rather than
# refusing. So match on what a build tree contains instead of what it is
# called. None of these are ever authored by hand.
**/CMakeCache.txt
**/CMakeFiles/
**/_deps/
**/cmake_install.cmake
**/CTestTestfile.cmake
**/compile_commands.json
**/metalquichaConfig.cmake
**/metalquichaConfigVersion.cmake

# A generated Makefile is the one build-tree artefact that shares its name with
# a file we author, so the rule is by name with the one real one exempted.
**/Makefile
!mqc_docs/Makefile

# The compiled test drivers, which sit beside their sources under a build tree
# and carry no extension to tell them apart from one.
test_mqc_*
!test_mqc_*.f90
!test_mqc_*.F90

# The executables a build links at the root of its tree: `mqc` itself and the
# validation and benchmark programs, each named for its target. Same problem as
# the test drivers -- no extension is the only thing telling a linked binary
# apart from the source it was built from -- so each prefix un-ignores the
# extensions we actually author under it. Every tracked name under these
# prefixes has one; none of the binaries does.
mqc
check_*
bench_*
sweep_*
probe_*
!check_*.f90
!check_*.py
!check_*.sh
!bench_*.f90
!bench_*.py
!bench_*.sh
!sweep_*.f90
!sweep_*.py
!sweep_*.sh
!probe_*.f90
!probe_*.py
!probe_*.sh
# ... except the two directories the pattern catches that are not binaries: the
# CPU validation decks under validation/inputs/cpu/mqc/ and the Python package
# under python/mqc/. Without this every file added to either since the rule was
# written is silently untracked, and `git add` refuses even a tracked one.
!validation/inputs/cpu/mqc/
!python/mqc/

# profiling / scratch
*.nsys-rep
*.sqlite
fail.txt

# Scratch input decks written by the test suite. The tests delete these
# themselves; this is for the run that crashed before it got there. One case
# writes deliberately malformed JSON, so a stray copy fails the check-json hook.
test/*_scratch.json

# Basis sets are extracted from the Basis Set Exchange bundle at CMake
# configure time (see cmake/modules/ExtractBasisSets.cmake). The bundle is
# tracked; the ~900 JSON files it can yield are not.
basis_sets/*.json

# Python bytecode caches -- regenerated on every run, interpreter-version specific
__pycache__/
*.pyc

# Local Python virtual environments
.venv/
venv/

# ctest scratch, swept in once by a broad git add
Testing/

# Build and run logs, whatever the run redirected to. This began as
# pyscf-forge DFDH's tmp_timing.log -- a profiler log it writes beside
# whatever invoked it, which only the validation reference generator ever
# calls -- and widened to the pattern after a broad `git add` swept two
# build logs into a commit. Nothing here is ever authored by hand.
*.log

# Throwaway Fortran drivers for poking at the library by hand -- see
# scratch/README.md, which is the only tracked thing in there. Nothing under
# scratch/ is built by the CMake build or run by ctest.
scratch/*
!scratch/README.md
!scratch/build.sh
